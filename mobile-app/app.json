{
  "expo": {
    "name": "Smart Home",
    "slug": "smart-home-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.smarthome.automation",
      "infoPlist": {
        "NSCameraUsageDescription": "Used strictly to toggle your physical phone flashlight (torch) as a smart light bulb."
      }
    },
    "android": {
      "package": "com.smarthome.automation",
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Used strictly to toggle your physical phone flashlight (torch) as a smart light bulb."
        }
      ]
    ]
  }
}
