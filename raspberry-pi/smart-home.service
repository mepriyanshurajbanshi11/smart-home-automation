[Unit]
Description=Smart Home MQTT Controller for Raspberry Pi
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/smart-home/raspberry-pi
ExecStart=/usr/bin/python3 /home/pi/smart-home/raspberry-pi/controller.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
